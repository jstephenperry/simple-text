<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimpleText.Avalonia.Views.MainWindow"
        Title="Untitled - SimpleText"
        Icon="/Assets/app.ico"
        Width="1000" Height="650"
        MinWidth="400" MinHeight="300">

  <DockPanel>
    <!-- Menu Bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem x:Name="NewMenuItem" Header="_New" InputGesture="Ctrl+N" />
        <MenuItem x:Name="NewFromTemplateMenu" Header="New from _Template" />
        <MenuItem x:Name="OpenMenuItem" Header="_Open..." InputGesture="Ctrl+O" />
        <Separator />
        <MenuItem x:Name="SaveMenuItem" Header="_Save" InputGesture="Ctrl+S" />
        <MenuItem x:Name="SaveAsMenuItem" Header="Save _As..." InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem x:Name="CloseMenuItem" Header="_Close Tab" InputGesture="Ctrl+W" />
        <Separator />
        <MenuItem x:Name="ExitMenuItem" Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Mode">
        <MenuItem x:Name="ModePlainText" Header="_Plain Text" />
        <MenuItem x:Name="ModeMarkdown" Header="_Markdown" />
        <MenuItem x:Name="ModeAsciiDoc" Header="_AsciiDoc" />
        <MenuItem x:Name="ModeRst" Header="_reStructuredText" />
      </MenuItem>
      <MenuItem x:Name="InsertMenu" Header="_Insert" />
      <MenuItem Header="_Format">
        <MenuItem x:Name="AlignTableMenuItem" Header="_Align Table" InputGesture="Ctrl+Shift+T" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Theme">
          <MenuItem x:Name="ThemeSystem" Header="Follow _System" />
          <MenuItem x:Name="ThemeLight" Header="_Light" />
          <MenuItem x:Name="ThemeDark" Header="_Dark" />
        </MenuItem>
        <MenuItem x:Name="WordWrapMenuItem" Header="_Word Wrap" />
        <Separator />
        <MenuItem x:Name="ZoomInMenuItem" Header="Zoom _In" InputGesture="Ctrl+OemPlus" />
        <MenuItem x:Name="ZoomOutMenuItem" Header="Zoom _Out" InputGesture="Ctrl+OemMinus" />
        <MenuItem x:Name="ResetZoomMenuItem" Header="_Reset Zoom" InputGesture="Ctrl+D0" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="UserManualMenuItem" Header="_User Manual" />
        <Separator />
        <MenuItem x:Name="OpenTemplatesFolderMenuItem" Header="Open _Templates Folder" />
      </MenuItem>
    </Menu>

    <!-- Dismissible info banner (hidden by default) -->
    <Border x:Name="InfoBanner" DockPanel.Dock="Top" IsVisible="False"
            Padding="10,6"
            Background="#FFF4E5"
            BorderBrush="#E0B070" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="InfoBannerText" Grid.Column="0"
                   Foreground="#7A5200"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
        <Button x:Name="InfoBannerClose" Grid.Column="1" Content="✕"
                Width="24" Height="24" Padding="0"
                Background="Transparent" BorderThickness="0"
                Foreground="#7A5200"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Find Bar (hidden by default) -->
    <Border x:Name="FindBar" DockPanel.Dock="Top" IsVisible="False"
            Padding="8,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Find:" VerticalAlignment="Center" />
        <TextBox x:Name="FindTextBox" Width="260" />
        <Button x:Name="FindNextButton" Content="Next" />
        <Button x:Name="FindPrevButton" Content="Prev" />
        <Button x:Name="FindCloseButton" Content="X" Width="32" />
        <TextBlock x:Name="NoMatchesText" Text="No matches"
                   Foreground="Red" VerticalAlignment="Center"
                   IsVisible="False" />
      </StackPanel>
    </Border>

    <!-- Status Bar -->
    <Border DockPanel.Dock="Bottom" Padding="10,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="120,*,110,60">
        <TextBlock x:Name="StatusLineCol" Grid.Column="0" Text="Ln 1, Col 1"
                   FontSize="12" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusFileName" Grid.Column="1" Text="Untitled"
                   FontSize="12" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatusFileType" Grid.Column="2" Text="Plain Text"
                   FontSize="12" VerticalAlignment="Center" TextAlignment="Center" />
        <TextBlock x:Name="StatusEncoding" Grid.Column="3" Text="UTF-8"
                   FontSize="12" VerticalAlignment="Center" TextAlignment="Right" />
      </Grid>
    </Border>

    <!-- Tab area: TabControl fills the rest, with a "+" button top-right -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TabControl x:Name="Tabs" Grid.Column="0" />
      <Button x:Name="AddTabButton" Grid.Column="1"
              Content="+" FontSize="16" Width="32"
              Margin="2,2,4,0"
              VerticalAlignment="Top"
              ToolTip.Tip="New tab (Ctrl+N)" />
    </Grid>
  </DockPanel>
</Window>
