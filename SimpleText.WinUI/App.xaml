<Application
    x:Class="SimpleText.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Tint the selected tab with the system accent color (subtle, theme-adaptive;
                 updates live when the user changes their Windows accent). -->
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.18" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
