<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SimpleText.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Highlighting\Grammars\rst.tmLanguage.json" />
  </ItemGroup>

  <!--
    Default templates ship as ordinary files (not embedded resources) and are seeded
    into the user's templates folder on first run by TemplateSeeder. Each frontend
    links them into its own output under Templates\Defaults\ so AppContext.BaseDirectory
    resolves them at runtime. They are deliberately not compiled or embedded here.
  -->
  <ItemGroup>
    <None Include="Templates\Defaults\**\*" />
  </ItemGroup>

</Project>
