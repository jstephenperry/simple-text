<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SimpleText.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Highlighting\Grammars\rst.tmLanguage.json" />
  </ItemGroup>

  <!--
    Default templates live as ordinary files under Templates\Defaults\ (picked up by the
    SDK's default None glob). They are deliberately not embedded or compiled: each frontend
    links them into its own output under Templates\Defaults\ for first-run seeding by
    TemplateSeeder, so AppContext.BaseDirectory resolves them at runtime.
  -->

</Project>
